# "mock": everything from the in-app mock (src/api/mock).
# "hybrid": parking from VITE_API_BASE_URL, place search and routing from the built-in providers.
# "http": everything from VITE_API_BASE_URL.
# Production builds use .env.production (hybrid, via the Worker proxy).
VITE_API_MODE=mock
VITE_API_BASE_URL=https://api.example.com/v1

# Any MapLibre-compatible style. OpenFreeMap needs no API key.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# OSRM-compatible router the mock uses for real road routes (public demo server by default).
VITE_ROUTING_URL=https://router.project-osrm.org
# Valhalla router, tried first; OSRM is the second choice, then a simple offline route.
VITE_VALHALLA_URL=https://valhalla1.openstreetmap.de

# Where the map opens when location is unavailable (lat,lng).
VITE_DEFAULT_CENTER=50.0677,19.9916
VITE_DEFAULT_CENTER_NAME=Tauron Arena
