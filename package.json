{
  "name": "park-radar-front",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test.unit": "vitest",
    "test.e2e": "cypress run",
    "lint": "eslint",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "live:ios": "cap run ios -l --host $(ipconfig getifaddr en0) --port 5173",
    "live:android": "\"${ANDROID_HOME:-$HOME/Library/Android/sdk}/platform-tools/adb\" reverse tcp:5173 tcp:5173 && cap run android -l --host localhost --port 5173",
    "live:android:wifi": "cap run android -l --host $(ipconfig getifaddr en0) --port 5173",
    "deploy": "npm run build && wrangler deploy",
    "deploy:krakow": "tsc && vite build --mode krakow && wrangler deploy -c wrangler.krakow.jsonc"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource-variable/figtree": "^5.3.0",
    "@ionic/react": "^9.0.0",
    "@ionic/react-router": "^9.0.0",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "h3-js": "^4.5.0",
    "ionicons": "^8.1.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.11.2",
    "polyclip-ts": "^0.16.8",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-map-gl": "^8.1.3",
    "react-router": "^6.30.0",
    "react-router-dom": "^6.30.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@testing-library/dom": ">=7.21.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-legacy": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "cypress": "^13.5.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^22.1.0",
    "terser": "^5.16.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "~4.0.18",
    "wrangler": "^4.147.0"
  },
  "description": "Park Radar: live parking availability map (Ionic React + Capacitor + MapLibre)"
}
