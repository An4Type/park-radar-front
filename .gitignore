# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# build output
/dist
/dev-dist
*.tsbuildinfo

# testing
/coverage
/cypress/screenshots
/cypress/videos
/cypress/downloads

# environment (keep .env.example committed)
.env
.env.*
!.env.example
!.env.production
!.env.krakow

# native build artefacts (platform folders have their own .gitignore too)
/ios/DerivedData
/android/.idea
*.keystore
*.jks

# misc
.DS_Store
/.nx
/.nx/cache
/.vscode/*
!/.vscode/extensions.json
.idea

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Optional eslint cache
.eslintcache

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
